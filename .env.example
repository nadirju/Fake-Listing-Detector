# Copy to .env for local development (git-ignored). Never commit real keys.
GEMINI_API_KEY=
SERPAPI_API_KEY=
FIRECRAWL_API_KEY=
JINA_API_KEY=

# Optional tuning (defaults shown)
GEMINI_MODEL=gemini-2.5-flash
SERPAPI_ENGINE=google_lens
EXTRACTOR_ORDER=direct,firecrawl,jina
EXTRACTOR_TIMEOUT=12
EXTRACTION_BUDGET=25
WHOIS_TIMEOUT=8
IMAGE_TIMEOUT=15
GEMINI_TIMEOUT=25
MAX_RESPONSE_BYTES=2000000
MAX_REDIRECTS=4
MAX_IMAGES_TO_SEARCH=2
CACHE_TTL_SECONDS=900
SESSION_HOURLY_LIMIT=20
LOG_LEVEL=INFO

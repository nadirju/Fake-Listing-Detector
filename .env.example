# Optional: enable Gemini explanations. Without a key, deterministic analysis still works.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Optional: SerpAPI reverse-image search (availability depends on your plan).
SERPAPI_API_KEY=
# Set true to disable all outbound page fetching; demo and manual input still work.
DISABLE_NETWORK=false
REQUEST_TIMEOUT_SECONDS=8
CACHE_TTL_SECONDS=300

# Gemini API key for structured AI analysis (optional; falls back to deterministic-only mode)
GEMINI_API_KEY=

# SerpAPI key for reverse image search (optional; reverse image search check will be marked unavailable)
SERPAPI_KEY=

# Gemini model name (optional; default is gemini-2.0-flash)
GEMINI_MODEL=gemini-2.0-flash

# Cache TTL in seconds for repeated URL lookups
CACHE_TTL_SECONDS=1800